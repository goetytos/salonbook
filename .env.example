# ─── Database (Supabase) ─────────────────────────────────
# Go to: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Use the "Transaction" (port 6543) connection string for Vercel serverless
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Paste the public Supabase production CA certificate as a multiline value.
# Download: https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt
SUPABASE_DB_CA_CERT=
# Migrations require a direct or Supavisor "Session" connection on port 5432.
# `npm run db:migrate` prefers this value and refuses Supabase port 6543.
# MIGRATION_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Authentication ────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Separate 32+ byte key used only to HMAC rate-limit identities. Do not reuse
# JWT_SECRET and do not expose this value through a NEXT_PUBLIC_ variable.
RATE_LIMIT_HMAC_SECRET=

# ─── Application ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required before accepting real customer or business data.
NEXT_PUBLIC_LEGAL_NAME=
# Required before opening invitation requests to a real pilot business.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NODE_ENV=development

# ─── Transactional SMS (disabled by default) ──────────
# Sending stays off unless this value is exactly "true".
SMS_NOTIFICATIONS_ENABLED=false
# Use "sandbox" with username "sandbox" while testing; use "production" only
# after Africa's Talking has approved the registered Sender ID.
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
# Optional; accepted range is 1000-10000 milliseconds.
AFRICASTALKING_TIMEOUT_MS=5000
# Strong random value (32+ bytes) used by Vercel Cron as Authorization: Bearer.
# Leave blank until the outbox worker is deliberately activated.
CRON_SECRET=

# ─── Future Modules (not active yet) ──────────────────
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
